{
  "name": "obsidian-tasks-calendar",
  "version": "1.0.7",
  "description": "A calendar view for tasks in an Obsidian vault.",
  "private": true,
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.18.0",
  "allowScripts": {
    "esbuild@0.28.1": true
  },
  "scripts": {
    "build": "npm run check && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "check": "biome check . && tsc --build",
    "check:write": "biome check --write .",
    "clean": "node scripts/clean.mjs",
    "deploy": "node scripts/deploy.mjs",
    "release": "npm run clean && npm run test && npm run build && node scripts/package-release.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "calendar",
    "tasks"
  ],
  "author": "Obsidian Tasks Calendar contributors",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "0.28.1",
    "obsidian": "^1.8.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "date-fns": "^4.4.0",
    "motion": "^12.42.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rrule": "^2.8.1"
  }
}
