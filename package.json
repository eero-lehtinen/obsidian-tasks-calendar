{
  "name": "obsidian-tasks-calendar",
  "version": "1.5.4",
  "description": "A calendar view for tasks in an Obsidian vault.",
  "private": true,
  "main": "main.js",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "pnpm run check && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "check": "biome check . && tsc --build",
    "check:write": "biome check --write .",
    "clean": "node scripts/clean.mjs",
    "deploy": "node scripts/deploy.mjs",
    "release": "pnpm run clean && pnpm run test && pnpm run build && node scripts/package-release.mjs",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "calendar",
    "tasks"
  ],
  "author": "Eero Lehtinen",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@codemirror/state": "6.5.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "obsidian": "^1.13.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "chrono-node": "2.10.1",
    "date-fns": "^4.4.0",
    "motion": "^13.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rrule": "^2.8.1"
  }
}
